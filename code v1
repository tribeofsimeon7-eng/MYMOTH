<!-- THREE.JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128/examples/js/loaders/GLTFLoader.js"></script>

<style>
#moth-canvas{
  position:fixed;
  inset:0;
  width:100vw;
  height:100vh;
  pointer-events:none;
  z-index:999;
}
</style>

<div id="moth-canvas"></div>

<script>

const container = document.getElementById("moth-canvas");

/* SCENE */

const scene = new THREE.Scene();

const camera = new THREE.PerspectiveCamera(
  60,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);

camera.position.z = 6;

/* RENDERER */

const renderer = new THREE.WebGLRenderer({
  alpha:true,
  antialias:true
});

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);

renderer.outputEncoding = THREE.sRGBEncoding;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

renderer.physicallyCorrectLights = true;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;

container.appendChild(renderer.domElement);

/* LIGHTING */

const ambient = new THREE.AmbientLight(0xffffff,0.9);
scene.add(ambient);

/* subtle artwork color pickup */

const artBounce = new THREE.HemisphereLight(
  0xff8ad8,
  0x24180f,
  0.22
);
scene.add(artBounce);

/* warm reflected light */

const warmFill = new THREE.DirectionalLight(0xffd9a6,0.55);
warmFill.position.set(4,3,2);
scene.add(warmFill);

/* main light from top-right */

const keyLight = new THREE.DirectionalLight(0xfff8ee,3.8);
keyLight.position.set(6,8,7);

keyLight.castShadow = true;

keyLight.shadow.mapSize.width = 2048;
keyLight.shadow.mapSize.height = 2048;

keyLight.shadow.camera.near = 0.5;
keyLight.shadow.camera.far = 25;

keyLight.shadow.camera.left = -6;
keyLight.shadow.camera.right = 6;
keyLight.shadow.camera.top = 6;
keyLight.shadow.camera.bottom = -6;

scene.add(keyLight);

/* soft fill */

const fillLight = new THREE.DirectionalLight(0xffffff,0.25);
fillLight.position.set(-5,-2,-3);
scene.add(fillLight);

const coolFill = new THREE.DirectionalLight(0xbfd6ff,0.18);
coolFill.position.set(-6,-4,-2);
scene.add(coolFill);

/* very soft wall shadow */

const wallGeometry = new THREE.PlaneGeometry(20,20);

const wallMaterial = new THREE.ShadowMaterial({
  opacity:0.18
});

const wall = new THREE.Mesh(wallGeometry,wallMaterial);

wall.position.set(-0.12,-0.08,-1.4);
wall.receiveShadow = true;

scene.add(wall);

/* MODEL */

const loader = new THREE.GLTFLoader();

let moth = null;
let mixer = null;

const clock = new THREE.Clock();

loader.load(

  "https://cdn.jsdelivr.net/gh/tribeofsimeon7-eng/MYMOTH@6e63dc0b4e58fd77e0b94d496b692da058a80c18/Moth_V3.glb",


  function(gltf){

    moth = gltf.scene;

    /* slightly bigger */

moth.scale.set(3.9,3.9,3.9);

    /* orientation */

    moth.rotation.x = 1.0;
moth.rotation.y = 3.2;
moth.rotation.z = 0.1;

setTimeout(() => {
  introComplete = true;
}, 4800);

/* material tuning */

moth.traverse((child)=>{

  if(child.isMesh){

    child.castShadow = true;
    child.receiveShadow = true;

    if(child.material){

      child.material.roughness = 0.78;
      child.material.metalness = 0.0;
      child.material.envMapIntensity = 0.15;

    }

  }

});

scene.add(moth);
    if(gltf.animations && gltf.animations.length > 0){

      mixer = new THREE.AnimationMixer(moth);

      gltf.animations.forEach((clip)=>{

        const action = mixer.clipAction(clip);

        action.play();
        action.timeScale = 1.15;

      });

    }

  },

  undefined,

  function(error){

    console.error("GLB failed to load:", error);

  }

);
const introScale = 3.9;
const heroScale = 3.45;

/* MOUSE */

const mouse = {x:0,y:0};

window.addEventListener("mousemove",(event)=>{

  mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
  mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

});

/* ANIMATION */

const verticalOffset = 1.25;   // above the loading text
let introComplete = false;

function animate(){

  requestAnimationFrame(animate);

  const delta = clock.getDelta();

  if(mixer) mixer.update(delta);

 if(moth){

  if(!introComplete){

    moth.position.x += (0 - moth.position.x) * 0.08;
    moth.position.y += (1.35 - moth.position.y) * 0.08;

    const s = moth.scale.x + (introScale - moth.scale.x) * 0.08;
    moth.scale.set(s,s,s);

    moth.position.z = 0;

  }else{

    const targetX = mouse.x * 2.1;
    const targetY = mouse.y * 1.1 + 0.65;

    moth.position.x += (targetX - moth.position.x) * 0.025;
    moth.position.y += (targetY - moth.position.y) * 0.025;

    const s = moth.scale.x + (heroScale - moth.scale.x) * 0.03;
    moth.scale.set(s,s,s);

    moth.position.z = Math.sin(clock.elapsedTime * 0.45) * 0.06;

  }

}

  renderer.render(scene,camera);

}

animate();

/* RESIZE */

window.addEventListener("resize",()=>{

  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();

  renderer.setSize(window.innerWidth, window.innerHeight);

});

</script>
